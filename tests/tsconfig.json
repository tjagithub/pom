{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "rootDir": "..",
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "./**/*",
    "../examples/**/*",
    "../src/**/*",
    "../packages/pom/src/v1/**/*"
  ],
  "exclude": ["./verify-build.spec.ts"]
}
