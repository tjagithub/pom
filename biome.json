{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "assist": {
    "actions": {
      "recommended": true,
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "recommended": true,
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true,
    "includes": [
      "src/**/*.{ts,tsx}",
      "examples/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}"
    ]
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "enabled": true,
    "expand": "auto",
    "formatWithErrors": true,
    "includes": ["src/**/*", "examples/**/*", "tests/**/*"],
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "trailingNewline": true,
    "useEditorconfig": true
  },
  "javascript": {
    "assist": {
      "enabled": true
    },
    "formatter": {
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    },
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "formatter": {
      "bracketSpacing": true,
      "enabled": true,
      "expand": "auto",
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 80,
      "trailingCommas": "none",
      "trailingNewline": true
    }
  },
  "linter": {
    "domains": {
      "playwright": "all",
      "project": "all",
      "test": "all",
      "types": "all"
    },
    "enabled": true,
    "includes": [
      "src/**/*.{ts,tsx}",
      "examples/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}"
    ],
    "rules": {
      "a11y": "on",
      "complexity": "on",
      "correctness": "on",
      "nursery": "on",
      "performance": "on",
      "recommended": true,
      "security": "on",
      "style": "on",
      "suspicious": "on"
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": false,
    "useIgnoreFile": false
  }
}
